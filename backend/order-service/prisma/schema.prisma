generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE
}

// ==========================================
// CUSTOMER
// ==========================================

/// Cached local customer record for the Order Service.
/// Customer information is intentionally kept local so
/// the Order Service does not depend on another database.
model Customer {
  id    String  @id @default(uuid()) @db.Uuid
  phone String  @unique @db.VarChar(20)
  name  String? @db.VarChar(255)

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([phone])
  @@map("customers")
}

// ==========================================
// ORDER
// ==========================================

/// Core order record.
///
/// restaurantId, staffId, tableId and customerId are
/// references used by the Order Service. There are no
/// cross-service foreign keys.
model Order {
  id String @id @default(uuid()) @db.Uuid

  /// Sequential order number.
  /// Unique only within a restaurant.
  orderNumber Int @default(autoincrement()) @map("order_number")

  /// Prevents duplicate order creation during retries.
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(255)

  // ------------------------------------------
  // CONTEXT & ROUTING
  // ------------------------------------------
  restaurantId String  @map("restaurant_id") @db.Uuid
  staffId      String? @map("staff_id") @db.Uuid
  tableId      String? @map("table_id") @db.VarChar(50)

  // ------------------------------------------
  // CUSTOMER
  // ------------------------------------------
  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  // ------------------------------------------
  // ORDER STATE
  // ------------------------------------------
  status OrderStatus @default(PENDING)
  type   OrderType

  // ------------------------------------------
  // FINANCIAL TOTALS
  // ------------------------------------------
  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // ------------------------------------------
  // CANCELLATION
  // ------------------------------------------
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?   @map("cancel_reason") @db.VarChar(500)

  // ------------------------------------------
  // RELATIONS
  // ------------------------------------------
  items    OrderItem[]
  payments Payment[]

  // ------------------------------------------
  // TIMESTAMPS
  // ------------------------------------------
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // ------------------------------------------
  // INDEXES
  // ------------------------------------------
  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([customerId])
  @@map("orders")
}

// ==========================================
// ORDER ITEM
// ==========================================

/// Immutable snapshot of a catalog item at the
/// moment the order was created.
///
/// menuItemId is a soft reference to Catalog Service.
/// name and price are snapshots and must not change
/// when the Catalog item changes later.
model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status OrderItemStatus @default(PENDING)
  // ------------------------------------------
  // CATALOG REFERENCE
  // ------------------------------------------
  menuItemId String @map("menu_item_id") @db.Uuid

  // ------------------------------------------
  // SNAPSHOT
  // ------------------------------------------
  name     String  @db.VarChar(255)
  price    Decimal @db.Decimal(10, 2)
  quantity Int     @default(1) @db.SmallInt

  /// price × quantity
  total Decimal @db.Decimal(10, 2)

  // ------------------------------------------
  // MODIFIERS
  // ------------------------------------------
  modifiers OrderItemModifier[]

  // ------------------------------------------
  // INDEXES
  // ------------------------------------------
  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// ==========================================
// ORDER ITEM MODIFIER
// ==========================================

/// Immutable snapshot of a modifier applied
/// to an order item.
///
/// modifierId is a soft reference to Catalog Service.
model OrderItemModifier {
  id String @id @default(uuid()) @db.Uuid

  orderItemId String    @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // ------------------------------------------
  // CATALOG REFERENCE
  // ------------------------------------------
  modifierId String @map("modifier_id") @db.Uuid

  // ------------------------------------------
  // SNAPSHOT
  // ------------------------------------------
  name     String  @db.VarChar(255)
  price    Decimal @db.Decimal(10, 2)
  quantity Int     @default(1) @db.SmallInt

  // ------------------------------------------
  // INDEX
  // ------------------------------------------
  @@index([orderItemId])
  @@index([modifierId])
  @@map("order_item_modifiers")
}

// ==========================================
// PAYMENT
// ==========================================

/// Payment ledger associated with an order.
///
/// Multiple payment records can exist for an order,
/// allowing retries and future partial-payment support.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  transactionId String?       @unique @map("transaction_id") @db.VarChar(255)

  // ------------------------------------------
  // REFUND
  // ------------------------------------------
  refundedAt DateTime? @map("refunded_at") @db.Timestamptz(3)

  // ------------------------------------------
  // TIMESTAMPS
  // ------------------------------------------
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // ------------------------------------------
  // INDEXES
  // ------------------------------------------
  @@index([orderId])
  @@index([status])
  @@map("payments")
}
