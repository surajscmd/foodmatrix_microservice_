# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 14.


DATABASE_URL="postgresql://postgres:root@localhost:5432/fmx_organization"
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_SECRET=""
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# Optional HTTPS mail webhook that accepts { email, resetUrl } and sends the reset email.
PASSWORD_RESET_WEBHOOK_URL=""
PASSWORD_RESET_WEBHOOK_TOKEN=""
