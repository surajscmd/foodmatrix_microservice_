generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Franchise {
  id              String  @id @default(uuid())
  name            String  @unique
  taxId           String?
  defaultCurrency String  @default("INR")

  regions     Region[]
  systemUsers SystemUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Region {
  id   String @id @default(uuid())
  name String

  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  restaurants Restaurant[]

  systemUsers SystemUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([franchiseId, name])
  @@index([franchiseId])
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

model Restaurant {
  id      String  @id @default(uuid())
  name    String
  address String
  city    String
  state   String?
  country String

  timezone String           @default("UTC")
  status   RestaurantStatus @default(ACTIVE)

  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  systemUsers SystemUser[]
  terminals   Terminal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regionId, name])
  @@index([regionId])
}

enum SystemUserRole {
  SUPER_ADMIN
  FRANCHISE_ADMIN
  REGIONAL_ADMIN
  RESTAURANT_ADMIN
}

enum TerminalType {
  ORDER
  KITCHEN
  ATTENDANCE
}

// ==========================================
// SYSTEM USER
// Administrative users only
// ==========================================

model SystemUser {
  id String @id @default(uuid())

  // Better Auth user ID - Soft Reference
  authUserId String @unique

  firstName String
  lastName  String
  email     String @unique

  role SystemUserRole

  // Organizational scope
  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  managedRegionId String?
  region          Region? @relation(fields: [managedRegionId], references: [id])

  managedRestaurantId String?
  restaurant          Restaurant? @relation(fields: [managedRestaurantId], references: [id])

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([franchiseId])
  @@index([managedRegionId])
  @@index([managedRestaurantId])
}

// ==========================================
// TERMINAL
// Restaurant operational devices
// ==========================================

model Terminal {
  id String @id @default(uuid())

  name String
  type TerminalType

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Device pairing
  pairingCode String? @unique
  isPaired    Boolean @default(false)

  // Device information
  deviceModel String?
  lastPingAt  DateTime?

  // Soft activation/deactivation
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, type])
}
