generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum OrderStatus {
  OPEN
  PREPARING   // <-- Add this: Chef started cooking
  READY       // <-- Add this: Food is done
  PAID
  CANCELLED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id String @id @default(uuid())

  name  String?
  phone String?  @unique
  email String?  @unique

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  // Soft references
  restaurantId String
  terminalId   String?
  staffId      String

  // Optional customer
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Optional table for DINE_IN
  tableId String?

  status    OrderStatus @default(OPEN)
  orderType OrderType

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  serviceCharge  Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)

  // Lifecycle timestamps
  paidAt      DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?

  // Prevent duplicate order creation
  idempotencyKey String? @unique

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([terminalId])
  @@index([staffId])
  @@index([customerId])
  @@index([tableId])
}

// ============================================================
// ORDER ITEM
// ============================================================

model OrderItem {
  id String @id @default(uuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Soft reference to Catalog Service
  menuItemId String

  // Historical snapshot
  snapshotName String
  sku          String?

  unitPrice Decimal @db.Decimal(10, 2)

  quantity Int @default(1)

  // Calculated by server
  totalPrice Decimal @db.Decimal(12, 2)

  notes String?

  modifiers OrderItemModifier[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
}

// ============================================================
// ORDER ITEM MODIFIER
// ============================================================

model OrderItemModifier {
  id String @id @default(uuid())

  orderItemId String

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Soft reference to Catalog Service
  modifierId String

  // Historical snapshot
  snapshotName String
  extraPrice   Decimal @default(0) @db.Decimal(10, 2)

  quantity Int @default(1)

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([modifierId])
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id String @id @default(uuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod

  amount Decimal @db.Decimal(12, 2)

  status PaymentStatus @default(PENDING)

  gatewayTxnId String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([gatewayTxnId])
}
